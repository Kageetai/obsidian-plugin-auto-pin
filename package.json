{
	"name": "obsidian-sample-plugin",
	"version": "1.1.1",
	"description": "This is a sample plugin for Obsidian (https://obsidian.md)",
	"author": "Kageetai",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"format": "prettier --write \"src/**/*.ts\" \"*.{json,md,mjs}\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,mjs}\""
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "^25.1.0",
		"esbuild": "0.28.0",
		"esbuild-plugin-copy": "^2.1.1",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "17.4.0",
		"jiti": "2.6.1",
		"prettier": "^3.8.1",
		"tslib": "2.8.1",
		"typescript": "^6.0.2",
		"typescript-eslint": "8.58.1"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
